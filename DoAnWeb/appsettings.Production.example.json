{
  // ===========================================================================
  //  MẪU cấu hình Production cho bản web Quản lý gia sư (đề xuất #7).
  //  Cách dùng: sao chép file này thành appsettings.Production.json nằm CẠNH
  //  DoAnWeb.dll trong thư mục cài dịch vụ, rồi sửa Path/Password cho đúng.
  //  KHÔNG commit file appsettings.Production.json thật (có mật khẩu chứng chỉ).
  //  Hướng dẫn đầy đủ: docs/trien-khai.md
  // ===========================================================================
  //
  //  Khi KHÔNG khai báo mục Kestrel dưới đây, web nghe theo biến môi trường
  //  ASPNETCORE_URLS do scripts/cai-dich-vu-web.ps1 đặt (mặc định
  //  http://0.0.0.0:5080). Khai báo Kestrel:Endpoints thì ASPNETCORE_URLS bị bỏ qua.
  "Kestrel": {
    "Endpoints": {
      // HTTP cho máy trong LAN; bỏ mục Http nếu chỉ muốn HTTPS.
      "Http": {
        "Url": "http://0.0.0.0:5080"
      },
      // HTTPS cho máy trong LAN: chứng chỉ tự tạo (dev cert / mkcert), xem docs.
      "Https": {
        "Url": "https://0.0.0.0:5443",
        "Certificate": {
          "Path": "C:\\ProgramData\\QuanLyGiaSu\\chung-chi\\quanlygiasu.pfx",
          "Password": "DOI_MAT_KHAU_PFX"
        }
      }
    }
  },
  // Bật khi đã có HTTPS: cookie đăng nhập chỉ gửi qua HTTPS (an toàn hơn).
  "BaoMat": {
    "BatBuocHttps": true
  },
  "AllowedHosts": "*"
}
