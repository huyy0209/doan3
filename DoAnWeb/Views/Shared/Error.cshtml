@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
    Layout = "_LayoutTrong";
}
<div class="vo-panel-narrow g3-center">
    <div class="vo-error-code">!</div>
    <div class="vo-error-title">Có lỗi xảy ra khi xử lý yêu cầu</div>
    <p class="vo-error-text mb-3">
        Hệ thống chưa hoàn tất được thao tác. Anh/chị thử lại; nếu vẫn lỗi,
        báo quản lý kèm mã yêu cầu bên dưới.
    </p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="vo-muted g3-small">
            Mã yêu cầu: <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
        <a href="/" class="btn btn-primary">
            <partial name="_Icon" model='"home"' />Về trang chủ
        </a>
        <a href="/TaiKhoan/DangNhap" class="btn btn-outline-secondary">Đăng nhập lại</a>
    </div>
</div>
