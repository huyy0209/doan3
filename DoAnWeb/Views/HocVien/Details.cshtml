@model DoAnWeb.ViewModels.HocVien.HocVienDetailsVM
@{
    ViewData["Title"] = "Hồ sơ học viên";
    ViewData["PageSub"] = Model.HocVien.HoTen;
    var hv = Model.HocVien;
}
@section Styles {
    <link rel="stylesheet" href="~/css/w1.css" asp-append-version="true" />
}
<div class="d-flex justify-content-end gap-2 mb-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a>
    @if (Model.LaQuanLy)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@hv.MaHV">Sửa hồ sơ</a>
    }
</div>
@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success" role="status">@TempData["ThongBao"]</div>
}
<div class="row g-3">
    <div class="col-lg-5">
        <section class="vo-card">
            <div class="vo-section">Thông tin hồ sơ</div>
            <dl class="w1-details">
                <dt>SĐT liên hệ</dt><dd>@(hv.SDTLienHe ?? "—")</dd>
                <dt>SĐT học viên</dt><dd>@(hv.SDT ?? "—")</dd>
                <dt>Phụ huynh</dt><dd>@(hv.TenPhuHuynh ?? "—")</dd>
                <dt>SĐT phụ huynh</dt><dd>@(hv.SDTPhuHuynh ?? "—")</dd>
                <dt>Trường / lớp</dt><dd>@(hv.TruongLop ?? "—")</dd>
                <dt>Trình độ</dt><dd>@(hv.TrinhDo ?? "—")</dd>
                <dt>Địa chỉ</dt><dd>@(hv.DiaChi ?? "—")</dd>
                <dt>Ghi chú</dt><dd class="w1-notes">@(hv.GhiChu ?? "—")</dd>
            </dl>
        </section>
        <section class="vo-card mt-3">
            <div class="vo-section">Theo dõi học tập</div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary" href="/HocTap/KetQua/@hv.MaHV">Kết quả học tập</a>
                <a class="btn btn-outline-primary" href="/DiemDanh">Điểm danh</a>
            </div>
        </section>
    </div>
    <div class="col-lg-7">
        <section class="vo-card">
            <div class="vo-section">Các lớp</div>
            @if (Model.LopHocs.Count == 0)
            {
                <div class="vo-empty">Học viên chưa có lớp học.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table vo-table align-middle">
                        <thead><tr><th>Lớp / môn</th><th>Gia sư</th><th>Ca học</th><th>Trạng thái</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var lop in Model.LopHocs)
                            {
                                <tr>
                                    <td>@lop.TenHienThi</td>
                                    <td>@(lop.GiaSu?.HoTen ?? "—")</td>
                                    <td>@(lop.CaHoc ?? "—")</td>
                                    <td>@(lop.TrangThaiTheoThoiGian ?? "—")</td>
                                    <td class="text-end"><a asp-controller="LopHoc" asp-action="Details" asp-route-id="@lop.MaLop">Chi tiết</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
