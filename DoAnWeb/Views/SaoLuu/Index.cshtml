@model DoAnWeb.ViewModels.SaoLuuVM.SaoLuuIndexVM
@{
    ViewData["Title"] = "Sao lưu CSDL";
    ViewData["PageSub"] = "Tạo, quản lý và khôi phục các bản sao lưu.";
}

<section class="vo-card p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="h5 mb-1">Sao lưu cơ sở dữ liệu</h2>
            <p class="text-muted mb-0">
                Tự sao lưu: @(string.Equals(Model.GioTuDong, "Tat", StringComparison.OrdinalIgnoreCase) ? "đã tắt" : $"hằng ngày lúc {Model.GioTuDong}").
            </p>
        </div>
        <form asp-action="SaoLuuNgay" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Sao lưu ngay</button>
        </form>
    </div>
</section>
@if (!string.IsNullOrWhiteSpace(Model.Loi))
{
    <div class="alert alert-danger" role="alert">@Model.Loi</div>
}

<section class="vo-card p-4 mb-4">
    <h2 class="h5">Các file sao lưu</h2>
    @if (Model.Tep.Count == 0)
    {
        <p class="text-muted mb-0">Chưa có file sao lưu.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th scope="col">Tên file</th><th scope="col">Ngày sao lưu</th><th scope="col">Dung lượng</th><th scope="col" class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach (var tep in Model.Tep)
                    {
                        <tr>
                            <td>@tep.Ten</td>
                            <td>@tep.Ngay.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@($"{tep.KichThuoc / 1024d / 1024d:N2} MB")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Tai" asp-route-tenTep="@tep.Ten">Tải về</a>
                                <a class="btn btn-sm btn-outline-warning" asp-action="KhoiPhuc" asp-route-tenTep="@tep.Ten">Khôi phục</a>
                                <form asp-action="Xoa" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tenTep" value="@tep.Ten" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-xac-nhan="Xóa file sao lưu này?">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
