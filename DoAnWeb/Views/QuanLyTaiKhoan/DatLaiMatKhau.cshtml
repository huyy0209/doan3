@model DoAnWeb.ViewModels.QuanLyTaiKhoan.DatLaiMatKhauVM
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["PageSub"] = $"Tài khoản: {Model.TenDangNhap}. Đặt lại mật khẩu sẽ gỡ trạng thái tạm khóa.";
}
@section Styles {
    <link rel="stylesheet" href="~/css/w1.css" asp-append-version="true" />
}
<section class="vo-card w1-form-card">
    <form asp-action="DatLaiMatKhau" asp-route-id="@Model.MaTK" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="MaTK" type="hidden" />
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <div class="mb-3">
            <label asp-for="MatKhauMoi" class="form-label"></label>
            <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="XacNhan" class="form-label"></label>
            <input asp-for="XacNhan" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="XacNhan" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Đặt lại mật khẩu</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
