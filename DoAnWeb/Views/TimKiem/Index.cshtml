@model DoAnWeb.ViewModels.TimKiemVM.TimKiemIndexVM
@{
    ViewData["Title"] = "Tìm kiếm";
}
<div class="tk-page">
    <form class="tk-form-trang" method="get" action="/TimKiem" role="search">
        <label class="visually-hidden" for="tk-q-trang">Từ khóa tìm kiếm</label>
        <input id="tk-q-trang" class="form-control tk-input-trang" type="search" name="q"
               value="@Model.KetQua.TuKhoa" autocomplete="off"
               placeholder="Nhập ít nhất 2 ký tự: tên, SĐT, môn học…" />
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
    </form>

    @if (!Model.DuDai)
    {
        <div class="vo-card tk-huong-dan">
            <p class="tk-huong-dan-dong">Gõ ít nhất <strong>2 ký tự</strong> để tìm học viên, gia sư hoặc lớp học.</p>
            <p class="tk-huong-dan-dong">Không cần gõ dấu: <em>do bao ngoc</em> vẫn tìm ra <em>Đỗ Bảo Ngọc</em>.</p>
        </div>
    }
    else if (Model.Nhom.Count == 0)
    {
        <div class="vo-empty">
            Không tìm thấy học viên, gia sư hay lớp học nào khớp với “@Model.KetQua.TuKhoa”.
        </div>
    }
    else
    {
        foreach (var nhom in Model.Nhom)
        {
            <partial name="_NhomKetQua" model="nhom" />
        }
    }
</div>
