<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Bản web của DoAnWD: ASP.NET Core 8 MVC + EF Core 8 (Database-First, giữ nguyên schema QuanLyGiaSu) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Máy chỉ có runtime .NET 10: cho phép chạy ứng dụng net8 trên runtime mới hơn -->
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoAnWeb</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- Ghi nhật ký hệ thống ra file theo ngày (đề xuất #5) -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Cho DoAnWeb.Tests truy cập các thành phần internal (nếu cần) -->
  <ItemGroup>
    <InternalsVisibleTo Include="DoAnWeb.Tests" />
  </ItemGroup>

</Project>
